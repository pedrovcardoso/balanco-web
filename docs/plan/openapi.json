  "components": {
    "schemas": {
      "AttemptIn": {
        "properties": {
          "score": {
            "type": "integer",
            "maximum": 100,
            "minimum": 0,
            "title": "Score"
          },
          "hintsUsed": {
            "type": "integer",
            "maximum": 99,
            "minimum": 0,
            "title": "Hintsused",
            "default": 0
          },
          "attemptsUsed": {
            "anyOf": [
              {
                "type": "integer",
